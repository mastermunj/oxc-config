{
  "name": "@mastermunj/oxc-config",
  "version": "0.0.6",
  "description": "Shared oxlint + oxfmt configuration for TypeScript packages",
  "keywords": [
    "config",
    "format",
    "lint",
    "oxfmt",
    "oxlint",
    "typescript"
  ],
  "homepage": "https://github.com/mastermunj/oxc-config#readme",
  "bugs": {
    "url": "https://github.com/mastermunj/oxc-config/issues"
  },
  "license": "MIT",
  "author": "Munjal Dhamecha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastermunj/oxc-config.git"
  },
  "files": [
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "dist/"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint.config.d.ts",
      "default": "./dist/oxlint.config.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.config.d.ts",
      "default": "./dist/oxfmt.config.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "format:report": "node ./scripts/format_report.mjs",
    "lint": "oxlint .",
    "lint:fix": "npm run lint -- --fix",
    "prepublishOnly": "npm run build",
    "release": "commit-and-tag-version",
    "release:mock": "npm run release -- --dry-run"
  },
  "devDependencies": {
    "commit-and-tag-version": "^13.1.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14"
  }
}
